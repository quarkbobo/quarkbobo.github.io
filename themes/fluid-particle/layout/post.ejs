<% if (page.path === '/' || page.path === 'index.html') { %>
  <%- partial('_partial/home', {
    catalogue: page,
    posts: site.posts.sort('-date').filter(post => post.path !== '/' && post.path !== 'index.html')
  }) %>
<% } else { %>
  <%- partial('_partial/post-full', { post: page }) %>
<% } %>
