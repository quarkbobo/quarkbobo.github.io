<%
const cardCategories = post.categories && typeof post.categories.toArray === 'function'
  ? post.categories.toArray()
  : Array.from(post.categories || [])
%>
<article class="post-card">
  <p class="post-card__date"><time datetime="<%= date_xml(post.date) %>"><%= dateFormatter.format(new Date(post.date)) %></time></p>
  <h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3>
  <% if (cardCategories.length) { %>
    <ul class="post-card__categories" aria-label="分类">
      <% cardCategories.forEach(category => { %>
        <li><a href="<%= url_for(category.path) %>"><%= category.name %></a></li>
      <% }) %>
    </ul>
  <% } %>
  <% const summary = post_lead(post.raw || post._content || '') %>
  <% if (summary) { %><p class="post-card__summary"><%= summary %></p><% } %>
  <a class="post-card__link" href="<%= url_for(post.path) %>" aria-label="阅读《<%= post.title %>》">阅读全文 <span aria-hidden="true">↗</span></a>
</article>
