<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#010208">
  <meta name="description" content="<%= config.description || theme.hero.description %>">
  <title><%= page.title ? page.title + ' · ' + config.title : config.title %></title>
  <%- css('css/main.css') %>
  <%- css('css/post.css') %>
  <%- css('css/cursor-comet.css') %>
  <% if (page.path === 'index.html' || page.path === '/') { %>
    <link rel="modulepreload" href="<%= url_for('/vendor/three/three.core.min.js') %>">
    <link rel="modulepreload" href="<%= url_for('/vendor/three/three.module.min.js') %>">
    <link rel="modulepreload" href="<%= url_for('/js/planet-world.mjs') %>">
    <link rel="modulepreload" href="<%= url_for('/js/planet-flight.mjs') %>">
    <%- css('css/space-scene.css') %>
    <%- css('css/planet-explorer.css') %>
    <script src="<%= url_for('/js/particle-core.js') %>" defer></script>
    <script src="<%= url_for('/js/particle-flow.js') %>" defer></script>
    <script src="<%= url_for('/js/home-latest-core.js') %>" defer></script>
    <script src="<%= url_for('/js/home-latest.js') %>" defer></script>
    <script src="<%= url_for('/js/planet-explorer.mjs') %>" type="module"></script>
  <% } %>
  <script src="<%= url_for('/js/cursor-comet-core.js') %>" defer></script>
  <script src="<%= url_for('/js/cursor-comet.js') %>" defer></script>
  <script src="<%= url_for('/js/site.js') %>" defer></script>
  <%- css('css/archive-a.css') %>
  <%- css('css/three-body.css') %>
  <script src="<%= url_for('/js/three-body.mjs') %>" type="module"></script>
</head>
