<%
const allHomePosts = posts && typeof posts.toArray === 'function' ? posts.toArray() : Array.from(posts || [])
const homePosts = allHomePosts.filter(post => {
  const source = String(post.source || '').replace(/\\/g, '/')
  return !source.endsWith('/博客目录.md') && source !== '博客目录.md' &&
    !(post.path === 'index.html' && post.title === '博客目录')
})
const homeDateOptions = { year: 'numeric', month: 'long', day: 'numeric' }
if (config.timezone) homeDateOptions.timeZone = config.timezone
const homeDateFormatter = new Intl.DateTimeFormat(config.language || 'zh-CN', homeDateOptions)
%>
<%- partial('_partial/three-body') %>
<div class="home-shell" data-fluid-home>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="hero-eyebrow"><%= theme.hero.eyebrow %></p>
      <p class="site-name"><%= config.title %></p>
      <h1 id="home-title"><%= theme.hero.title %></h1>
      <p class="hero-description"><%= theme.hero.description %></p>
      <div class="hero-actions">
        <button id="planet-enter" class="planet-enter" type="button" aria-haspopup="dialog" aria-controls="planet-explorer">
          <svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><circle cx="14" cy="14" r="7"/><ellipse cx="14" cy="14" rx="13" ry="4.5" transform="rotate(-28 14 14)"/></svg>
          <span>进入星球</span><span class="planet-enter__arrow" aria-hidden="true">↗</span>
        </button>
        <a class="hero-entry" href="#latest-posts">进入最新记录 <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-motion">
        <button id="motion-toggle" class="motion-toggle" type="button" aria-pressed="false" aria-controls="space-scene">暂停背景动态</button>
      </div>
    </div>
    <div class="hero-scene" data-fluid-scene>
      <%- partial('_partial/space-scene') %>
      <div id="planet-viewport" class="planet-viewport">
        <canvas id="planet-webgl" role="button" tabindex="0" aria-label="环形星球，按 Enter 进入星球内部" aria-haspopup="dialog" aria-controls="planet-explorer"></canvas>
      </div>
      <div class="planet-caption" aria-hidden="true">
        <span class="planet-caption__signal"></span>
        <span>穿过云层，探索星球内部</span>
        <span class="planet-caption__line"></span>
      </div>
    </div>
  </section>

  <section id="latest-posts" class="home-section" aria-labelledby="latest-title">
    <div class="section-heading">
      <div>
      <p class="section-kicker">LATEST ENTRIES</p>
      <h2 id="latest-title">最新记录</h2>
      </div>
      <a href="<%= url_for('/archives/') %>">全部归档 <span aria-hidden="true">→</span></a>
    </div>
    <% if (homePosts.length) { %>
      <div class="post-grid" data-latest-grid>
        <% homePosts.slice(0, 2).forEach(post => { %>
          <%- partial('_partial/post-card', { post, dateFormatter: homeDateFormatter }) %>
        <% }) %>
      </div>
    <% } else { %>
      <p class="empty-state">档案中还没有记录。<a href="<%= url_for('/') %>">返回首页</a></p>
    <% } %>
  </section>

  <section class="catalogue-section home-section" aria-labelledby="catalogue-title">
    <div class="section-heading">
      <div>
      <p class="section-kicker">CATALOGUE</p>
      <h2 id="catalogue-title">按主题找文章</h2>
      </div>
    </div>
    <div class="catalogue-content"><%- String(catalogue.content || '').replace(/(<h3\b[\s\S]*?<\/h3>)\s*(<ul\b[\s\S]*?<\/ul>)/g, '<section class="catalogue-topic">$1$2</section>') %></div>
  </section>
</div>
<%- partial('_partial/planet-explorer') %>
